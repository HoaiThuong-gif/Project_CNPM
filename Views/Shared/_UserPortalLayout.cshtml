@{
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var pageTitle = ViewData["Title"]?.ToString() ?? "Hệ thống dự đoán thuốc";
    var sectionTitle = ViewData["UserSection"]?.ToString() ?? pageTitle;
    var userName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = "Người dùng";
    }

    var duDoanActions = new[] { "nhapthongtinbenh", "ketquadudoan" };
    var lichSuActions = new[] { "lichsutracuu" };
    var tongQuanActions = new[] { "tongquan" };

    string UserNavClass(string section)
    {
        var isActive = section switch
        {
            "predict" => duDoanActions.Contains(currentAction),
            "history" => lichSuActions.Contains(currentAction),
            "overview" => tongQuanActions.Contains(currentAction),
            _ => false
        };

        return isActive ? "user-sidebar-link is-active" : "user-sidebar-link";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle | MedPredict</title>
    <link rel="stylesheet" href="~/css/shared/UserPortal.css" asp-append-version="true">
    @RenderSection("Styles", required: false)
</head>
<body class="user-portal-body">
    <div class="user-shell">
        <aside class="user-sidebar">
            <div>
                <div class="user-sidebar-brand">
                    <span class="user-sidebar-brand-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 12.5 10.5 16 18 8.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <rect x="3" y="4" width="18" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2" />
                        </svg>
                    </span>
                    <div class="user-sidebar-brand-text">
                        <strong>MedPredict</strong>
                        <span>Hệ thống dự đoán thuốc</span>
                    </div>
                </div>

                <nav class="user-sidebar-nav">
                    <a class="@UserNavClass("predict")" asp-controller="DuDoan" asp-action="NhapThongTinBenh">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a5 5 0 0 0-5 5c0 2.12 1.2 3.69 2.35 5.21C10.47 13.71 11 14.5 11 15.5V18a1 1 0 0 0 .55.89l2 1A1 1 0 0 0 15 19v-3.5c0-1 .53-1.79 1.65-3.29C17.8 10.69 19 9.12 19 7a5 5 0 0 0-5-5Z" fill="currentColor" /></svg>
                        <span>Dự đoán thuốc</span>
                    </a>

                    <a class="@UserNavClass("history")" asp-controller="DuDoan" asp-action="LichSuTraCuu">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3a9 9 0 1 0 8.95 10H20a7 7 0 1 1-2.05-4.95L15 11h7V4l-2.64 2.64A8.94 8.94 0 0 0 13 3Zm-1 5h2v5l4 2-.9 1.79L11 14Z" fill="currentColor" /></svg>
                        <span>Lịch sử tra cứu</span>
                    </a>

                    <a class="@UserNavClass("overview")" asp-controller="DuDoan" asp-action="TongQuan">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6V4H4Zm10 7h6V4h-6ZM4 20h6v-5H4Zm0-7h6v-2H4Zm10 7h6v-5h-6Z" fill="currentColor" /></svg>
                        <span>Tổng quan</span>
                    </a>
                </nav>
            </div>

            <div class="user-sidebar-footer">
                <div class="user-sidebar-profile">
                    <span class="user-sidebar-avatar">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" fill="currentColor" /></svg>
                    </span>
                    <span>
                        <strong id="userPortalName">@userName</strong>
                        <span>Người dùng</span>
                    </span>
                    <a id="logoutLink"
                       class="user-sidebar-logout"
                       asp-controller="Account"
                       asp-action="DangXuat"
                       data-logout-url="@Url.Action("DangXuat", "Account")"
                       title="Đăng xuất">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17v-2h5V9h-5V7h5a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2ZM7.41 12l2.3 2.29-1.42 1.42L3.59 12l4.7-3.71 1.42 1.42Z" fill="currentColor" /></svg>
                    </a>
                </div>
            </div>
        </aside>

        <div class="user-content-shell">
            <header class="user-topbar">
                <div class="user-breadcrumb">@sectionTitle</div>

                <div class="user-topbar-actions">
                    <button class="user-icon-button" type="button" aria-label="Thông báo">
                        <span class="user-notification-dot"></span>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3a4 4 0 0 0-4 4v1.1a7 7 0 0 1-1.53 4.37L5 14.25V16h14v-1.75l-1.47-1.78A7 7 0 0 1 16 8.1V7a4 4 0 0 0-4-4Zm0 18a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 21Z" fill="currentColor" />
                        </svg>
                    </button>

                    <div class="user-topbar-profile">
                        <span class="user-topbar-avatar">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" fill="currentColor" /></svg>
                        </span>
                        <span id="userTopbarName">@userName</span>
                    </div>
                </div>
            </header>

            <main class="user-main-frame">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/shared/Auth.js" asp-append-version="true"></script>
    <script>
        (function () {
            const username = localStorage.getItem("username");
            if (!username) return;
            const sidebarName = document.getElementById("userPortalName");
            const topbarName = document.getElementById("userTopbarName");
            if (sidebarName) sidebarName.textContent = username;
            if (topbarName) topbarName.textContent = username;
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
