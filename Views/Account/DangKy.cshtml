@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký | MedPredict</title>
    <link rel="stylesheet" href="~/css/shared/PublicPortal.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/account/DangKy.css" asp-append-version="true">
</head>
<body class="portal-body">
    <div class="portal-shell">
        <aside class="portal-aside">
            <div class="portal-aside-content">
                <div class="portal-brand">
                    <span class="portal-brand-badge"></span>
                    <span>MedPredict</span>
                </div>

                <h1 class="portal-title">Tạo tài khoản để bắt đầu tra cứu</h1>
                <p class="portal-description">
                    Đăng ký để lưu lịch sử sử dụng, dùng chức năng dự đoán thuốc và theo dõi các cảnh báo an toàn theo dữ liệu hệ thống.
                </p>

                <div class="portal-feature-list">
                    <div class="portal-feature">
                        <span class="portal-feature-icon">•</span>
                        <span>Quản lý lịch sử tra cứu sau khi đăng nhập</span>
                    </div>
                    <div class="portal-feature">
                        <span class="portal-feature-icon">•</span>
                        <span>Tra cứu thuốc theo dữ liệu thật từ backend</span>
                    </div>
                    <div class="portal-feature">
                        <span class="portal-feature-icon">•</span>
                        <span>Truy cập nhanh sang khu đăng nhập và dashboard theo quyền</span>
                    </div>
                </div>
            </div>

            <div class="portal-footer-note">© 2026 MedPredict · Phiên bản học tập</div>
        </aside>

        <main class="portal-main">
            <div class="portal-main-inner">
                <div class="portal-alert">
                    Tài khoản đăng ký tại đây dùng để truy cập hệ thống demo. Vui lòng nhập đúng email và mật khẩu để tránh lỗi xác thực.
                </div>

                <div class="portal-tabs">
                    <a class="portal-tab" asp-controller="Account" asp-action="DangNhap">Đăng nhập</a>
                    <a class="portal-tab is-active" asp-controller="Account" asp-action="DangKy">Đăng ký</a>
                </div>

                <section class="portal-card">
                    <h2 class="portal-card-title">Tạo tài khoản mới</h2>
                    <p class="portal-card-subtitle">Điền thông tin để sử dụng hệ thống dự đoán thuốc</p>

                    <form class="portal-form register-form"
                          data-register-api="/api/Auth/register"
                          data-login-url="@Url.Action("DangNhap", "Account")">
                        <div class="portal-field">
                            <label for="registerName">Họ và tên</label>
                            <input class="portal-input" id="registerName" type="text" placeholder="Nhập họ tên..." required>
                        </div>

                        <div class="portal-field">
                            <label for="registerEmail">Email</label>
                            <input class="portal-input" id="registerEmail" type="email" placeholder="Nhập email..." required>
                        </div>

                        <div class="portal-field">
                            <label for="registerPassword">Mật khẩu</label>
                            <input class="portal-input" id="registerPassword" type="password" placeholder="Nhập mật khẩu..." required>
                        </div>

                        <div class="portal-field">
                            <label for="registerConfirmPassword">Xác nhận mật khẩu</label>
                            <input class="portal-input" id="registerConfirmPassword" type="password" placeholder="Nhập lại mật khẩu..." required>
                        </div>

                        <button type="submit" class="portal-button portal-button-primary btn-register">Tạo tài khoản</button>
                    </form>

                    <div class="portal-meta">
                        Đã có tài khoản?
                        <a class="portal-link-inline" asp-controller="Account" asp-action="DangNhap">Đăng nhập</a>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script src="~/js/account/DangKy.js" asp-append-version="true"></script>
</body>
</html>
