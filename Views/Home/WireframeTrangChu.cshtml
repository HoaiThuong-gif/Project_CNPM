<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wireframe Trang Chủ</title>

    <style>

        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body{
            background: #f5fbff;

            font-family: Arial, Helvetica, sans-serif;
        }

        .container{
            width: 95%;

            margin: auto;
        }

        .header{
            height: 80px;

            background: #bae6fd;

            border-radius: 20px;

            margin-top: 20px;
        }

        .hero{
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 30px;

            margin-top: 30px;
        }

        .hero-left,
        .hero-right{
            height: 500px;

            background: white;

            border-radius: 30px;
        }

        .features{
            margin-top: 30px;

            display: grid;

            grid-template-columns: repeat(3,1fr);

            gap: 20px;
        }

        .feature{
            height: 250px;

            background: white;

            border-radius: 25px;
        }

        .info{
            height: 400px;

            background: #ffffff;

            border-radius: 30px;

            margin-top: 30px;
        }

        .footer{
            height: 250px;

            background: #dbeafe;

            border-radius: 30px;

            margin: 30px 0;
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="header"></div>

        <div class="hero">

            <div class="hero-left"></div>

            <div class="hero-right"></div>

        </div>

        <div class="features">

            <div class="feature"></div>

            <div class="feature"></div>

            <div class="feature"></div>

        </div>

        <div class="info"></div>

        <div class="footer"></div>

    </div>

</body>

</html>