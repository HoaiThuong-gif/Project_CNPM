<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wireframe Form Bệnh</title>

    <style>

        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body{
            background: #f5fbff;

            font-family: Arial, Helvetica, sans-serif;
        }

        .container{
            width: 90%;

            margin: auto;
        }

        .header{
            height: 80px;

            background: #bae6fd;

            border-radius: 20px;

            margin-top: 20px;
        }

        .main{
            display: grid;

            grid-template-columns: 2fr 1fr;

            gap: 30px;

            margin-top: 30px;
        }

        .form-box{
            height: 700px;

            background: white;

            border-radius: 35px;
        }

        .side-box{
            display: flex;
            flex-direction: column;

            gap: 20px;
        }

        .card{
            height: 220px;

            background: white;

            border-radius: 30px;
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="header"></div>

        <div class="main">

            <div class="form-box"></div>

            <div class="side-box">

                <div class="card"></div>

                <div class="card"></div>

                <div class="card"></div>

            </div>

        </div>

    </div>

</body>

</html>