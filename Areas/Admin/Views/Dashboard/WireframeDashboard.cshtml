<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wireframe Dashboard</title>

    <style>

        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body{
            background: #f5fbff;

            font-family: Arial, Helvetica, sans-serif;

            display: flex;
        }

        .sidebar{
            width: 280px;

            min-height: 100vh;

            background: white;

            padding: 20px;
        }

        .logo{
            height: 70px;

            background: #bae6fd;

            border-radius: 20px;

            margin-bottom: 30px;
        }

        .menu-item{
            height: 55px;

            background: #f1f5f9;

            border-radius: 15px;

            margin-bottom: 15px;
        }

        .main{
            flex: 1;

            padding: 30px;
        }

        .topbar{
            height: 80px;

            background: white;

            border-radius: 25px;

            margin-bottom: 30px;
        }

        .cards{
            display: grid;

            grid-template-columns: repeat(4,1fr);

            gap: 20px;

            margin-bottom: 30px;
        }

        .card{
            height: 180px;

            background: white;

            border-radius: 30px;
        }

        .chart-section{
            display: grid;

            grid-template-columns: 2fr 1fr;

            gap: 20px;
        }

        .chart{
            height: 400px;

            background: white;

            border-radius: 30px;
        }

        .activity{
            height: 400px;

            background: white;

            border-radius: 30px;
        }

    </style>

</head>

<body>

    <div class="sidebar">

        <div class="logo"></div>

        <div class="menu-item"></div>
        <div class="menu-item"></div>
        <div class="menu-item"></div>
        <div class="menu-item"></div>
        <div class="menu-item"></div>

    </div>

    <div class="main">

        <div class="topbar"></div>

        <div class="cards">

            <div class="card"></div>
            <div class="card"></div>
            <div class="card"></div>
            <div class="card"></div>

        </div>

        <div class="chart-section">

            <div class="chart"></div>

            <div class="activity"></div>

        </div>

    </div>

</body>

</html>